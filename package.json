{
  "name": "akd",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npx tsx scripts/dev.ts",
    "build": "node scripts/build-main.mjs && node scripts/build-workers.mjs && npx vite build",
    "start": "electron dist/main/main/index.js"
  },
  "dependencies": {
    "@dalongrong/opencv-wasm": "^4.8.1-1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron": "^42.0.1",
    "electron-store": "^11.0.2",
    "lucide-vue-next": "^0.400.0",
    "onnxruntime-node": "^1.26.0",
    "sharp": "^0.34.5",
    "vue": "^3.5.34"
  },
  "build": {
    "appId": "com.akd.app",
    "productName": "AKD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@techstark/opencv-js/**"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
